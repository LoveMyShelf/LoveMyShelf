<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="AppFont">Segoe UI, Malgun Gothic</FontFamily>
  <SolidColorBrush x:Key="Paper" Color="#17191C"/>
  <SolidColorBrush x:Key="Panel" Color="#23262A"/>
  <SolidColorBrush x:Key="Line" Color="#41454B"/>
  <SolidColorBrush x:Key="Text" Color="#ECEEF1"/>
  <SolidColorBrush x:Key="Subtle" Color="#B6BBC2"/>
  <SolidColorBrush x:Key="Accent" Color="#D3D5D9"/>
  <SolidColorBrush x:Key="Raised" Color="#373A3F"/>
  <SolidColorBrush x:Key="StrongLine" Color="#565B63"/>
  <!-- These colors are swapped at run time by Themes.cs (light / dark). Use DynamicResource for them. -->
  <SolidColorBrush x:Key="FocusLine" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ScrollThumb" Color="#64676B"/>
  <SolidColorBrush x:Key="CardBack" Color="#F226292E"/>
  <SolidColorBrush x:Key="CardLine" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="ViewerBar" Color="#00000000"/>
  <SolidColorBrush x:Key="TileBand" Color="#23262A"/>
  <SolidColorBrush x:Key="OnVideo" Color="#B3000000"/>
  <Style x:Key="TitleBarButton" TargetType="Button">
    <Setter Property="Width" Value="38"/>
    <Setter Property="Margin" Value="0,5,2,2"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Pad" Background="{TemplateBinding Background}" CornerRadius="6"
                  BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pad" Property="Background" Value="{DynamicResource Panel}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pad" Property="Background" Value="{DynamicResource Raised}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pad" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Pad" Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{DynamicResource Paper}">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                  <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="3,1" Background="{DynamicResource ScrollThumb}" CornerRadius="3"/></ControlTemplate></Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                </Track>
              </Grid>
              <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Track" Property="Opacity" Value="0"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
    <Setter Property="Background" Value="{DynamicResource Paper}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <!-- Ideal keeps Korean strokes even on scaled (125–200%) displays; Display snapped them unevenly. -->
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Panel}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
  </Style>
  <Style x:Key="OptionsTab" TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
    <Setter Property="Background" Value="{DynamicResource Paper}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid Background="{TemplateBinding Background}">
            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            <Border x:Name="Indicator" Height="1" VerticalAlignment="Bottom"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              <Setter Property="Background" Value="{DynamicResource Panel}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              <Setter Property="Background" Value="{DynamicResource Panel}"/>
              <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="11,4"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="{DynamicResource Panel}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FocusLine}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.73"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Raised}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource StrongLine}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="FolderFilterChoice" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="MinWidth" Value="58"/>
    <Setter Property="Margin" Value="0,0,3,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <!-- Always visible: a faint fill and a thin edge, so each choice reads as a button even when it is not picked. -->
            <Border x:Name="Box" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6"/>
            <Border x:Name="Focus" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Border x:Name="Indicator" Height="2" Margin="8,0" VerticalAlignment="Bottom" Background="Transparent"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Raised}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Raised}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- One choice in a row of choices that reads as a single control (speed, play style). The picked one is raised;
       the weight never changes, so the row never shifts. -->
  <Style x:Key="SegmentChoice" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              <Setter Property="Background" Value="{DynamicResource Raised}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource StrongLine}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FocusLine}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="SliderRail" TargetType="RepeatButton">
    <Grid Background="Transparent">
      <Border Height="3" VerticalAlignment="Center" Background="{TemplateBinding Background}"/>
    </Grid>
  </ControlTemplate>
  <Style TargetType="Slider">
    <Setter Property="Height" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Background="Transparent">
            <Border Height="3" VerticalAlignment="Center" Background="{DynamicResource StrongLine}"/>
            <Track x:Name="PART_Track" Focusable="False">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Background="{DynamicResource Accent}" Template="{StaticResource SliderRail}"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="Playhead" Width="10" Foreground="{TemplateBinding Foreground}">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid Background="Transparent">
                        <Border Width="5" Height="3" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource Accent}"/>
                        <Ellipse Width="10" Height="10" Fill="{TemplateBinding Foreground}"/>
                      </Grid>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Background="{DynamicResource StrongLine}" Template="{StaticResource SliderRail}"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Playhead" Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Playhead" Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
            <Trigger Property="IsMouseCaptured" Value="True"><Setter TargetName="Playhead" Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PlaybackTimeline" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
    <Setter Property="Height" Value="36"/>
    <Setter Property="Foreground" Value="Transparent"/>
  </Style>
  <Style x:Key="PlaybackSpeed" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="MinHeight" Value="23"/>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ComboBoxItem">
          <Setter Property="Foreground" Value="{DynamicResource Text}"/>
          <Setter Property="Padding" Value="8,4"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                  <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Panel}"/></Trigger>
                  <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Raised}"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Button" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7">
                    <Path Stroke="{DynamicResource Subtle}" Data="M 0 0 L 3 3 L 6 0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,8,0"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Button" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Margin="8,0,20,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"/>
            <Border x:Name="Focus" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" IsHitTestVisible="False"/>
            <Popup x:Name="PART_Popup" Placement="Top" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
              <Border Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="0,3" MinWidth="{TemplateBinding ActualWidth}">
                <ScrollViewer MaxHeight="200"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="OptionsChoice" TargetType="ComboBox" BasedOn="{StaticResource PlaybackSpeed}">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="MinHeight" Value="31"/>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
    </Style.Triggers>
  </Style>
  <!-- Right-click menus and the Sort menu: rounded, following the light/dark colors, a plain check for the current choice. -->
  <Style TargetType="ContextMenu">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="HasDropShadow" Value="True"/>
    <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Margin="0,0,10,10" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="4">
            <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.22" Color="Black"/></Border.Effect>
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Box" Background="Transparent" CornerRadius="6" Padding="6,6,10,6" MinWidth="190">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Check" Text="✓" Foreground="{DynamicResource Accent}" FontWeight="Bold" Visibility="Hidden" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Subtle}" Margin="24,0,0,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="Arrow" Grid.Column="3" Text="›" FontSize="15" Foreground="{DynamicResource Subtle}" Margin="12,-2,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
              <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-7" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                     IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Margin="0,0,10,10" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="4"
                        TextOptions.TextFormattingMode="Ideal">
                  <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.22" Color="Black"/></Border.Effect>
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Raised}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator"><Border Height="1" Margin="10,4,10,4" Background="{DynamicResource Line}"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
